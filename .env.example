# SETU Environment Configuration

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Google Cloud Text-to-Speech Credentials (Optional - fallback to gTTS active if omitted)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Whisper Speech-to-Text Model Size (tiny, base, small, medium, large)
WHISPER_MODEL_SIZE=base

# Base URL for public Twilio callback / static audio serving (e.g. https://xxxx.ngrok-free.app or http://localhost:8000)
BASE_URL=http://localhost:8000

# SQLite Database File Path
CACHE_DB_PATH=setu_cache.db

# Host & Port
HOST=0.0.0.0
PORT=8000
